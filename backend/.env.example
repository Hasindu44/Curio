# Copy this file to .env and fill in the values.

# MongoDB connection string (local or Atlas).
# Atlas example: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/curio
MONGODB_URI=mongodb://127.0.0.1:27017/curio

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Instructor account created by `npm run seed`. It can open the Lesson Studio.
INSTRUCTOR_NAME=Studio Instructor
INSTRUCTOR_EMAIL=instructor@curio.dev
INSTRUCTOR_PASSWORD=Instructor123

# Optional: DNS resolvers to use if system DNS refuses Atlas SRV lookups,
# e.g. 1.1.1.1,1.0.0.1. Leave empty to use system DNS.
DNS_SERVERS=
