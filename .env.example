# Copy this file to .env and replace the values below.
# MongoDB Atlas example: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/arcwise
MONGODB_URI=mongodb://127.0.0.1:27017/arcwise
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional: use these resolvers if system DNS refuses Atlas SRV lookups.
# Leave empty for system DNS, particularly for private-network databases.
DNS_SERVERS=

# Vite reads variables prefixed with VITE_. Set false to use MongoDB.
VITE_USE_MOCKS=false
