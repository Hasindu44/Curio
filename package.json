{
  "name": "curio-stem-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Curio: a gamified STEM learning platform (React + Express + MongoDB)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "npm run start -w backend",
    "build": "npm run build -w frontend",
    "seed": "npm run seed -w backend",
    "seed:reset": "npm run seed:reset -w backend",
    "test": "npm test -w backend",
    "test:ui": "npm run test:ui -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
